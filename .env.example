# ----------------------------------------------------------------------------
# Bunny Stream POC configuration
# Copy this file to ".env" and fill in the values from your Bunny dashboard.
# ----------------------------------------------------------------------------

# Stream > Your Library > "Library ID" (a number, e.g. 759)
BUNNY_LIBRARY_ID=

# Stream > Your Library > Manage Videos > the video's GUID (the default video
# the demo page will play). e.g. eb1c4f77-0cda-46be-b47d-1118ad7c2ffe
BUNNY_VIDEO_ID=

# Stream > Your Library > API > Security > "Token Authentication Key"
# (NOT the regular API key). This signs the embed/iframe tokens.
# Keep this SECRET — it must never reach the browser.
BUNNY_TOKEN_SECURITY_KEY=

# How long a generated signed playback URL stays valid, in seconds.
# Bunny recommends short-lived tokens (60-300s).
TOKEN_TTL_SECONDS=120

# Optional: a shared secret you set when creating the webhook in Bunny so we
# can verify incoming webhook calls. Leave blank to accept all (POC only).
WEBHOOK_SHARED_SECRET=

# Port the local server listens on.
PORT=3000
